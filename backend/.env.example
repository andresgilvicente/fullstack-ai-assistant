# Environment variables for running the backend outside Docker.
# Copy this file to `.env` inside `backend/`.

# Database: "true" selects PostgreSQL, "false" selects a local SQLite file.
USE_POSTGRES=false

# PostgreSQL connection (only used when USE_POSTGRES=true)
POSTGRES_DB=assistant_db
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS: allow every origin (development) or list explicit origins.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
