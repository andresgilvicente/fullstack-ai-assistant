# Copy this file to `.env` and adjust the values as needed.
# Docker Compose reads `.env` automatically; every variable below has a
# development default, so the file is optional for a first run.

# --- Ollama -----------------------------------------------------------------
# Models downloaded on start-up (comma-separated) and the model used for chat.
# Examples: llama3.2:1b (fastest), llama3.2:3b (balanced), mistral:7b, phi3:mini
OLLAMA_MODELS=llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_DB=assistant_db
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me

# --- Django -----------------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DEBUG=True

# --- Frontend ---------------------------------------------------------------
# Public URL of the backend as seen from the browser (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
